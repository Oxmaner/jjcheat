#!/bin/sh
# JJCheat roothide postinst
# 只做一件事：把 engine.js 放进目标 App 的 .app（Tweak 的第三条查找路径）
set +e
echo "[JJCheat] postinst: 安装后修复资源路径 (roothide)"
if [ -x /usr/bin/jjcheat-fix ]; then
    /usr/bin/jjcheat-fix
    echo "[JJCheat] postinst: jjcheat-fix 退出码 $?"
else
    echo "[JJCheat] postinst: 没找到 /usr/bin/jjcheat-fix"
fi
exit 0
