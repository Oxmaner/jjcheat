#!/bin/sh
# JJCheat 2.1.52 roothide postinst
#
# 2.1.52 起引擎跑在 dylib 进程内，包里不再有可执行文件，这里只剩两件事：
#   1) 确认 engine.js（识别脚本，dylib 内嵌副本兜底）就位
#   2) 确认 NNUE 权重就位并补读权限（引擎 mmap 读不到会直接退出）
#
# 注意：不往 .app 里搬任何文件。写 .app 会破坏 App 的代码签名。
set +e

APP_DIR="/Library/Application Support/JJCheat"
ENGINE="$APP_DIR/engine.js"
NET="$APP_DIR/Pikafish/pikafish.nnue"
OLD_PIKA="$APP_DIR/Pikafish/pikafish"

if [ -f "$ENGINE" ]; then
    echo "[JJCheat] postinst: engine.js 就位（$(wc -c < "$ENGINE" 2>/dev/null | tr -d ' ') 字节）"
else
    echo "[JJCheat] postinst: engine.js 缺失，但 dylib 内嵌副本仍可工作"
fi

# 2.1.51 及更早版本留下的可执行文件：进程内方案已经不用了，顺手清掉省 800KB
if [ -f "$OLD_PIKA" ]; then
    rm -f "$OLD_PIKA" && echo "[JJCheat] postinst: 已移除旧版独立引擎可执行文件"
fi

if [ -f "$NET" ]; then
    chmod 0644 "$NET" 2>/dev/null
    chown 0:0 "$NET" 2>/dev/null
    echo "[JJCheat] postinst: NNUE 权重就位（$(wc -c < "$NET" 2>/dev/null | tr -d ' ') 字节）"
else
    echo "[JJCheat] postinst: !! 包里没有 pikafish.nnue，引擎会启动即退出"
fi

echo "[JJCheat] postinst: 完成 —— 记得到 Bootstrap 的 App List 打开 JJ象棋 注入开关"
killall -9 SpringBoard 2>/dev/null || true
exit 0
