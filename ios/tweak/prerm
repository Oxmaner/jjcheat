#!/bin/sh
# JJCheat roothide prerm
# 卸载时把注入到 .app 里的 engine.js 撤掉（只删和我们那份完全一致的）
set +e
ENGINE="/Library/Application Support/JJCheat/engine.js"
ROOTFS="${JJ_ROOTFS:-/rootfs}"
APPS="$ROOTFS/var/containers/Bundle/Application"

[ -f "$ENGINE" ] || exit 0

for app in "$APPS"/*/*.app; do
    [ -d "$app" ] || continue
    target="$app/engine.js"
    [ -f "$target" ] || continue
    if cmp -s "$ENGINE" "$target"; then
        rm -f "$target" && echo "[JJCheat] prerm: 已移除 $target"
    fi
done
exit 0
